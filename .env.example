# ─────────────────────────────────────────────────────────────────────────────
# Silverback funnel: copy to .env.local (local) and add the same keys in
# Vercel → Project → Settings → Environment Variables.
# Every variable is optional for `npm run build`: the site falls back to
# src/config/pricing-fallback.ts and skips any tracking tag that isn't set.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose; used by /api/lead, /api/track, /api/owner/pricing.
SUPABASE_SERVICE_ROLE_KEY=

# Owner price editor: https://book.silverbackdetail.com/owner/prices?key=THIS_VALUE
# Use a long random string (min 16 chars), e.g. `openssl rand -hex 24`.
OWNER_PRICE_KEY=

# Live Google rating + top 5 reviews (Places API (New), server-only key).
# Google Cloud → APIs & Services → enable "Places API (New)" → Credentials → API key.
# Restrict the key to "Places API (New)". About 720 calls/month, inside Google's free 1,000.
GOOGLE_PLACES_API_KEY=
# Optional. Leave blank and the site finds the place automatically by name + address.
GOOGLE_PLACE_ID=

# Google Tag Manager container (GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=
# Optional direct Google Ads tag (AW-XXXXXXXXXX). Leave blank if Ads runs through GTM.
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Meta Pixel ID (numbers only)
NEXT_PUBLIC_META_PIXEL_ID=
# Optional server-side Meta Conversions API token (Events Manager → Settings)
META_CAPI_ACCESS_TOKEN=

# Domain verification (meta tag content values only)
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
